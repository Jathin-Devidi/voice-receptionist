# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your_groq_api_key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Used when running outside Docker. docker compose overrides DATABASE_URL and KOKORO_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/receptionist
KOKORO_URL=http://localhost:8880/v1

# Models (open-weight, served by Groq) and behaviour
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
STT_MODEL=whisper-large-v3-turbo
INTERRUPTION_MODE=vad
TURN_DETECTION=vad
BUSINESS_NAME=Sunrise Salon

# Latency tuning (defaults shown). Lower silence values = faster replies but a higher chance of cutting the caller off.
TTS_VOICE=af_heart            # Kokoro voice; am_michael / am_adam are male voices
VAD_MIN_SILENCE=0.3           # seconds of quiet before the caller is considered done (Silero default 0.55)
ENDPOINT_MIN_DELAY=0.3
PREEMPTIVE_TTS=1              # start speech synthesis before the turn is fully confirmed
LLM_ATTEMPT_TIMEOUT=3         # seconds before falling back to the smaller model
INFO_REFRESH_SECONDS=5        # how often business info is re-read from the database during a call
